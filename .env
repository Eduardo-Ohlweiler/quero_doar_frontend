# Url base da API do backend
VITE_API_BASE_URL="http://localhost:8080/api"

# Rotas de autenticação (POST /auth/login)
VITE_POST_AUTH_LOGIN_ROUTE="/auth/login"
# Rotas de autenticação (POST /auth/create)
VITE_POST_AUTH_CREATE_ROUTE="/auth/create"

# Rotas de usuário (GET /user/view/search)
VITE_GET_USER_VIEW_SEARCH_ROUTE="/user/view/search"
VITE_GET_USER_VIEW_SEARCH_USERID_PARAM="userId"
VITE_GET_USER_VIEW_SEARCH_EMAIL_PARAM="email"
# Rotas de usuário (GET /media/user/)
VITE_GET_MEDIA_USER_ROUTE="/media/user"
VITE_GET_MEDIA_USER_DEFAULT_PHOTO="default.webp"
