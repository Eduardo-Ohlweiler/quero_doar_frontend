# Url base da API do backend
VITE_API_BASE_URL="http://localhost:8080/"

### Autenticação de usuário ###
# Rotas de autenticação (POST /auth/login)
VITE_POST_AUTH_LOGIN_ROUTE="/api/auth/login"
# Identificador localStorage do token de autenticação
VITE_AUTH_TOKEN_STORAGE_KEY="authToken"
# Rotas de autenticação (POST /auth/create)
VITE_POST_AUTH_CREATE_ROUTE="/api/auth/create"
# Rota de criação de usuário (POST api/auth/user/create)
VITE_POST_AUTH_USER_CREATE_ROUTE="/api/auth/user/create"
# Rota de verificação de conta (POST /api/auth/user/verification)
VITE_POST_AUTH_VERIFY_ACCOUNT_ROUTE="/api/auth/user/verification"
# Rota de reenvio de email de verificação (POST /api/auth/user/resend-verification)
VITE_POST_AUTH_RESEND_VERIFICATION_ROUTE="/api/auth/user/resend-verification"
# Rota de solicitação de recuperação de senha (POST /api/auth/user/recover-password)
VITE_POST_AUTH_REQUEST_RESET_PASSWORD_ROUTE="/api/auth/user/request-reset-password"
# Rota de redefinição de senha (POST /api/auth/user/reset-password)
VITE_POST_AUTH_RESET_PASSWORD_ROUTE="/api/auth/user/reset-password"

### Rotas de usuário ###
# Rotas de usuário (GET /user/view/search)
VITE_GET_USER_VIEW_SEARCH_ROUTE="/api/user/view/search"
VITE_GET_USER_VIEW_SEARCH_USERID_PARAM="userId"
VITE_GET_USER_VIEW_SEARCH_EMAIL_PARAM="email"
# Rotas de usuário (GET /media/user/)
VITE_GET_MEDIA_USER_ROUTE="/media/user"
VITE_GET_MEDIA_USER_DEFAULT_PHOTO="default.webp"
# Rota de usuário para hall da fama (GET api/user/public/hall-of-fame/{top})
VITE_GET_USER_PUBLIC_HALL_OF_FAME_ROUTE="/api/user/public/hall-of-fame"

### Rotas de doação ###
# Rota de pré-visualização das últimas doações (GET /donation/preview/last)
VITE_GET_DONATION_PREVIEW_LAST_ROUTE="/api/donation/preview/last"
# Rota de media de doações (GET /media/donation/)
VITE_GET_MEDIA_DONATION_ROUTE="/media/donation"
VITE_GET_MEDIA_DONATION_DEFAULT_PHOTO="default.webp"
# Rota de pesquisa de doações (GET /api/donation/preview/search)
VITE_GET_DONATION_PUBLIC_SEARCH_ROUTE="/api/donation/preview/search"
VITE_GET_DONATION_PUBLIC_SEARCH_SEARCH_TERM_PARAM="searchTerm"
VITE_GET_DONATION_PUBLIC_SEARCH_PAGE_PARAM="page"
VITE_GET_DONATION_PUBLIC_SEARCH_SIZE_PARAM="size"
VITE_GET_DONATION_PUBLIC_SEARCH_SORT_BY_DISTANCE_PARAM="sortByDistance"
VITE_GET_DONATION_PUBLIC_SEARCH_ONLY_PUBLIC_PARAM="onlyPublic"
VITE_GET_DONATION_PUBLIC_SEARCH_ONLY_PRIVATE_PARAM="onlyPrivate"
VITE_GET_DONATION_PUBLIC_SEARCH_DISTANCE_KM_PARAM="distanceKm"
VITE_GET_DONATION_PUBLIC_SEARCH_SUBCATEGORIES_PARAM="subcategoriesIds"
VITE_GET_DONATION_PUBLIC_SEARCH_STATES_PARAM="statesIds"
VITE_GET_DONATION_PUBLIC_SEARCH_CITIES_PARAM="citiesIds"
VITE_GET_DONATION_PUBLIC_SEARCH_TAGS_PARAM="tagsIds"
VITE_GET_DONATION_PUBLIC_SEARCH_DONATION_TYPES_PARAM="donationTypes"

## Rotas de categorias ###
# Rota de categorias com contagem de doações disponíveis (GET api/category/donation/available)
VITE_GET_CATEGORY_DONATION_AVAILABLE_ROUTE="/api/category/donation/available"
# Rota de categorias completas (GET /api/category/public/all)
VITE_GET_CATEGORY_PUBLIC_ALL_ROUTE="/api/category/public/all"

## Rotas de localização ###
# Rota de estados (GET api/location/public/state/minimal)
VITE_GET_LOCATION_PUBLIC_STATE_MINIMAL_ROUTE="/api/location/public/state/minimal"
# Rota de cidades por estado (GET api/location/public/state/{stateId}/cities/minimal)
VITE_GET_LOCATION_PUBLIC_STATE_CITIES_MINIMAL_ROUTE="/api/location/public/state/{stateId}/cities/minimal"

### Configurações de tags ###
# Rota de tags públicas (GET /api/tag/public/all)
VITE_GET_TAG_PUBLIC_ALL_ROUTE="/api/tag/public/all"
